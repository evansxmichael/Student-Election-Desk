# Neon / PostgreSQL Connection
DATABASE_URL="postgresql://username:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Server Port
PORT=3001
NODE_ENV="production"

# Cryptographic Session Secret (Generate a strong random string)
JWT_SECRET="replace_with_a_long_random_secret_key"

# Initial Passwords for First-time Seed (Server-side Only)
ADMIN_INIT_PASS="admin123"
AGENT_INIT_PASS="agent123"
VIEWER_INIT_PASS="viewer123"
